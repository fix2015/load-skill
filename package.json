{
  "name": "load-skill",
  "version": "1.3.6",
  "description": "CLI tool to discover, search, and install AI coding skills for Claude Code, Cursor, Codex, Gemini CLI, and more",
  "main": "src/index.js",
  "bin": {
    "load-skill": "bin/load-skill.js"
  },
  "scripts": {
    "start": "node bin/load-skill.js",
    "scrape": "node src/scraper/index.js",
