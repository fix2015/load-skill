    "coding-assistant",
    "agent-skills",
    "cursorrules"
  ],
  "author": "fix2015",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fix2015/load-skill.git"
  },
  "bugs": {
    "url": "https://github.com/fix2015/load-skill/issues"
  },
  "homepage": "https://github.com/fix2015/load-skill#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ora": "^5.4.1",
    "node-fetch": "^2.7.0",
